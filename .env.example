# ManagedOps — copy to .env for local development.
# Every value here is safe to commit; real secrets live in AWS Secrets Manager.

NODE_ENV=development
TZ=UTC

# ---------- API ----------
API_PORT=4000
# Origins allowed to call the API with credentials. Exact match, comma separated.
CORS_ORIGINS=http://localhost:5173
# Public base URL of the web client, used in emailed links.
WEB_BASE_URL=http://localhost:5173

# ---------- Database ----------
DATABASE_URL=postgresql://managedops:managedops@localhost:5432/managedops?schema=public

# ---------- Auth ----------
# Generate for each environment with: openssl rand -hex 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef0123456789abcdef
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Set true behind TLS so the refresh cookie is only ever sent over HTTPS.
COOKIE_SECURE=false

# Encrypts the TOTP secrets at rest. Generate with `openssl rand -hex 32`.
MFA_SECRET_KEY=change-me-generate-a-32-byte-hex-key-for-real-deployments
# `required` forces enrolment for every role the permission matrix marks
# sensitive. `optional` still verifies anyone already enrolled; it exists for
# test environments, where one-use TOTP codes make repeated sign-ins impossible.
MFA_ENFORCEMENT=required

# ---------- Object storage (MinIO locally, S3 in AWS) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=managedops-dev
S3_ACCESS_KEY_ID=managedops
S3_SECRET_ACCESS_KEY=managedops-secret
# MinIO needs path-style addressing; real S3 does not.
S3_FORCE_PATH_STYLE=true

# ---------- Email (Mailpit locally, SES in AWS) ----------
# `log` renders each phone message into the application log, the way Mailpit
# catches email. `twilio` needs the account and both sender numbers below it.
MESSAGING_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+911234567890
# TWILIO_WHATSAPP_FROM=+911234567890

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ManagedOps <no-reply@managedops.local>"

# ---------- Seed ----------
# Password given to every seeded account. Development only.
SEED_PASSWORD=ManagedOps!2026
