{
  "name": "@managedops/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@managedops/tsconfig": "workspace:*",
    "typescript": "5.7.3",
    "vitest": "3.0.5",
    "@types/node": "22.10.7"
  }
}
