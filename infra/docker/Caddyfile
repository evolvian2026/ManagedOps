# Caddy terminates TLS, serves the built SPA and proxies the API.
#
# Chosen over Nginx because certificate issue and renewal are automatic — that
# removes an entire class of "the certificate expired on a Saturday" incidents
# for a system with no dedicated operations team.
{
	email {$ACME_EMAIL:ops@managedops.example}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# The API and the SPA share one origin, so the refresh cookie stays
	# SameSite=Strict and no CORS preflight is needed in production.
	handle /api/* {
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv
		# Hashed asset filenames are safe to cache indefinitely.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# index.html must never be cached, or a deploy ships stale asset links.
		header /index.html Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}
